# ast-grep / ripgrep shared ignore rules
# Prevents AST-aware tools from scanning huge generated/dependency directories

# Dependencies
node_modules/

# Build outputs
dist/
target/
src-tauri/target/

# Git internals
.git/

# Generated/cached directories
.tmp-gitnexus-reports/
.turbo/
.cache/
.vite/

# AI tool configs (large, not source code)
.superpowers/
.impeccable/
.opencode/
.opencode/**
.codex/
.codex/**
.claude/
.claude/**
.github/
.gitnexus/

# Generated code
src-tauri/gen/
src-tauri/icons/

# Automation caches
automation/runtime/
automation/**/__pycache__/
automation/**/*.pyc
