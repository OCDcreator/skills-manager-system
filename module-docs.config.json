{
  "version": 1,
  "groups": [
    {
      "name": "frontend",
      "sourceRoot": "src",
      "docsRoot": "docs/modules/frontend",
      "include": [
        "**/*.css",
        "**/*.ts",
        "**/*.tsx"
      ],
      "exclude": [
        "**/*.d.ts",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx"
      ],
      "docIgnore": [
        "README.md"
      ],
      "exactMappings": {}
    },
    {
      "name": "tauri",
      "sourceRoot": "src-tauri/src",
      "docsRoot": "docs/modules/tauri",
      "include": [
        "**/*.rs"
      ],
      "exclude": [
        "**/*.test.rs",
        "**/*_test.rs"
      ],
      "docIgnore": [
        "README.md"
      ],
      "exactMappings": {}
    }
  ]
}
