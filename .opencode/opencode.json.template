{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "lean-ctx": {
      "type": "local",
      "command": ["lean-ctx"],
      "enabled": true,
      "environment": {
        "LEAN_CTX_DATA_DIR": "{{LEAN_CTX_DATA_DIR}}"
      }
    },
    "gitnexus": {
      "type": "local",
      "command": {{GITNEXUS_COMMAND}},
      "enabled": true,
      {{GITNEXUS_EXTRA}}
      "timeout": 15000
    }
  }
}
