{
  "name": "skills-manager-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:module-docs:coverage": "node scripts/check-module-doc-coverage.mjs",
    "check:module-docs:diff": "node scripts/check-module-doc-diff.mjs",
    "check:module-docs": "npm run check:module-docs:coverage && npm run check:module-docs:diff",
    "test:architecture": "node --test scripts/check-architecture.test.mjs",
    "test:git-layout": "node --test scripts/git-layout.test.mjs",
    "test:agent-layout": "node --test scripts/agent-layout.test.mjs",
    "test:agent-brand-icon": "node --test scripts/agent-brand-icon.test.mjs",
    "test:bundle-splitting": "node --test scripts/bundle-splitting.test.mjs",
    "test:assistant-layout": "node --test scripts/assistant-layout.test.mjs",
    "test:agent-order": "node --test scripts/agent-order.test.mjs",
    "test:project-draft": "node --test scripts/project-draft.test.mjs",
    "test:external-sources-ui": "node --test scripts/external-sources-ui.test.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "list:module-docs": "node scripts/list-module-doc-targets-from-diff.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build",
    "verify": "npm run check:module-docs && npm run check:architecture && npm run test:architecture && npm run test:git-layout && npm run test:agent-layout && npm run test:agent-brand-icon && npm run test:bundle-splitting && npm run test:assistant-layout && npm run test:agent-order && npm run test:project-draft && npm run test:external-sources-ui && npm run build && cargo check --manifest-path src-tauri/Cargo.toml && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "clsx": "^2.1.1",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.11.1",
    "i18next": "^25.8.13",
    "lucide-react": "^0.575.0",
    "marked": "^18.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
